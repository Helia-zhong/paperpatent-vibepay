# 复制为 .env 后启动；未配置支付宝密钥时自动使用本地 RSA2 仿真引擎。
PORT=3002
DATABASE_PATH=./data/paperpatent.sqlite

# 支付宝开放平台沙箱应用。请填入应用私钥与支付宝公钥，勿提交真实凭据。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 可选：填支付宝收款账号 PID（2088 开头），异步通知将核对收款方。
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=http://localhost:3002/api/alipay/notify
ALIPAY_RETURN_URL=http://localhost:3002/api/alipay/return

# 可选：兼容 OpenAI Chat Completions 的模型服务。
# 未设置时使用明确标注的预设演示交付物。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# 按模型服务合同填写人民币 / 百万 Token 费率，成本由实际 usage 核算。
AI_INPUT_CNY_PER_1M=8
AI_OUTPUT_CNY_PER_1M=32
